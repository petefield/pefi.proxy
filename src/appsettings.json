{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "immich": {
        "ClusterId": "immich",
        "Match": {
          "Hosts" : ["photos.pefi.co.uk"]
        }
      }
    },
    "Clusters": {
      "immich": {
        "Destinations": {
          "destination1": {
            "Address": "http://pippin:2283"
          }
        }
      }
    }
  }
}