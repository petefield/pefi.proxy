# RabbitMQ connection
Messaging__address=rabbitmq
Messaging__username=guest
Messaging__password=guest

# Static routes (YARP config via environment variables)
# Format: ReverseProxy__Routes__{name}__{property}
# Format: ReverseProxy__Clusters__{name}__{property}
#
# To add a route, define:
#   ReverseProxy__Routes__{name}__ClusterId={cluster-name}
#   ReverseProxy__Routes__{name}__Match__Hosts__0={hostname}
#   ReverseProxy__Clusters__{cluster-name}__Destinations__destination1__Address={url}

# Example: route "immich" matching photos.pefi.co.uk
ReverseProxy__Routes__immich__ClusterId=immich
ReverseProxy__Routes__immich__Match__Hosts__0=photos.pefi.co.uk
ReverseProxy__Clusters__immich__Destinations__destination1__Address=http://host.docker.internal:2283
